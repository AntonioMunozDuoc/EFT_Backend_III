# Copia este archivo como ".env" y ajusta los valores.
# Si no existe .env, docker-compose usa los valores por defecto de desarrollo.

# Base de datos
DB_PASSWORD=root123
MYSQL_HOST_PORT=3307

# Secretos OAuth2 de los canales (los que usan Web, Mobile y ATM para pedir tokens)
WEB_CLIENT_SECRET=web-secret-dev
MOBILE_CLIENT_SECRET=mobile-secret-dev
ATM_CLIENT_SECRET=atm-secret-dev

# Secretos OAuth2 de cada BFF frente a los microservicios
BFF_WEB_SECRET=bff-web-secret-dev
BFF_MOBILE_SECRET=bff-mobile-secret-dev
BFF_ATM_SECRET=bff-atm-secret-dev

# Secretos OAuth2 de servicio a servicio
CUENTAS_SERVICE_SECRET=cuentas-service-secret-dev
PAGOS_SERVICE_SECRET=pagos-service-secret-dev
BATCH_OPERATOR_SECRET=batch-operator-secret-dev
