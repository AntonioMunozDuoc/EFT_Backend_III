<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.7</version>
        <relativePath/>
    </parent>

    <groupId>com.bancoxyz</groupId>
    <artifactId>banco-xyz-bff</artifactId>
    <version>0.0.1-SNAPSHOT</version>

    <packaging>pom</packaging>

    <name>Banco XYZ - EFT Semana 9</name>
    <description>
        Migracion batch (Spring Batch), BFF y microservicios resilientes con Spring Cloud
    </description>

    <properties>
        <java.version>21</java.version>
        <spring-cloud.version>2025.1.2</spring-cloud.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <modules>
        <module>bank-common</module>
        <module>config-server</module>
        <module>discovery-server</module>
        <module>auth-server</module>
        <module>clientes-service</module>
        <module>cuentas-service</module>
        <module>pagos-service</module>
        <module>batch-service</module>
        <module>bff-web</module>
        <module>bff-mobile</module>
        <module>bff-atm</module>
        <module>audit-service</module>
    </modules>

</project>

